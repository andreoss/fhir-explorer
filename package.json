{
  "name": "fhir-explorer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run coverage && pnpm run build && pnpm run assets && pnpm run policy",
    "test:live": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "assets": "node tools/assets.mjs",
    "policy": "node tools/policy.mjs",
    "qa": "playwright test --config playwright.qa.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/cytoscape": "^3.31.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-solid": "^0.18.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "cytoscape": "^3.34.3",
    "solid-js": "^1.9.15"
  }
}
